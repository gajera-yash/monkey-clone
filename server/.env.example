# Frontend Configuration (Add this to your React .env or Vercel Environment Variables)

# Socket / CORS Configuration
# Comma-separated allowed frontend origins for API + Socket (example below)
# FRONTEND_URL=https://your-frontend.vercel.app,https://www.yourdomain.com

# Frontend socket endpoint (set this in Vercel project env)
# REACT_APP_SOCKET_URL=https://your-railway-app.up.railway.app

# WebRTC TURN fallback (recommended for mobile data / strict NAT networks)
# Set these in frontend (Vercel) environment variables
# REACT_APP_TURN_URL=turn:your-turn-server:3478
# REACT_APP_TURN_USERNAME=your_turn_username
# REACT_APP_TURN_CREDENTIAL=your_turn_password
