{
    "buildCommand": "npm run build",
    "outputDirectory": "build",
    "framework": "create-react-app",
    "rewrites": [
        {
            "source": "/s/(.*)",
            "destination": "https://api.strangy.in/s/$1"
        },
        {
            "source": "/api/(.*)",
            "destination": "https://api.strangy.in/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}